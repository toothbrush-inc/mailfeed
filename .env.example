# ============================================
# MailFeed Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
# For Docker (docker compose up) this is set automatically — no need to change.
# For local dev without Docker, point to your Postgres instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailfeed"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key"

# --- Google OAuth (required) ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:3000/api/auth/callback/google
# 4. Enable the Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 5. Configure OAuth consent screen with gmail.readonly scope
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"

# --- Google Gemini API (required for AI analysis) ---
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="gemini-api-key"

# --- Optional: Alternative LLM providers for BAML ---
# These are only needed if you switch BAML functions to use OpenAI or Anthropic clients.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# --- Encryption at rest (optional, recommended) ---
# When a master key is set, emails, Gmail OAuth tokens, and per-user AI keys
# are encrypted with a per-user key (DEK) wrapped by that master key (KEK).
# Unset = data is stored unencrypted, exactly as before — fine for a
# single-user localhost setup. See docs/encryption.md.
#
# Local / self-hosted: a base64 32-byte key. Generate with:
#   openssl rand -base64 32
# Keep it safe: losing it makes the encrypted data unreadable.
# MAILFEED_KEK=""
#
# Hosted on GCP: use Cloud KMS instead — the KEK then never touches disk and
# every unwrap is IAM-gated and audit-logged. The runtime service account
# needs roles/cloudkms.cryptoKeyEncrypterDecrypter on the key.
# KMS_KEY_NAME="projects/<project>/locations/<loc>/keyRings/<ring>/cryptoKeys/<key>"
#
# Hosted instances should also set this: a missing key then fails loudly
# instead of silently downgrading to plaintext.
# MAILFEED_REQUIRE_ENCRYPTION=true

# --- Shared AI keys (hosted instances) ---
# By default the GEMINI_API_KEY above serves every signed-in user — right for
# a single-user setup. On a shared instance set this to false: each user then
# brings their own Gemini key in Settings (stored encrypted), so AI usage
# runs on their billing and rate limits. Without a key, AI features are
# disabled for that user; sync and the reading feed work regardless.
# MAILFEED_SHARED_ENV_KEYS=false

# --- Access control (hosted instances) ---
# Comma-separated list of emails allowed to sign in. Unset = anyone with a
# Google account can create an account, which is fine for localhost only.
# ALLOWED_EMAILS="you@example.com,family@example.com"

# Feature Flags
# Analysis on/off for the whole instance (there is no per-user switch): the
# Content Analysis section in Settings, AI summaries and highlights in the
# feed, the bulk analyze API, and the hourly worker's analysis pass. The
# browser bundle bakes it in at build time (docker compose passes it as a
# build arg) and the server + worker read it at runtime, so after changing
# it run `docker compose up --build -d`. Hosted instances set it true.
NEXT_PUBLIC_ENABLE_ANALYSIS=false

# --- Scheduled sync worker (docker compose `worker` service) ---
# Hourly Gmail check-new + Gemini Batch analysis/embeddings, no browser session.
# MAILFEED_SYNC_INTERVAL_MS=3600000
# MAILFEED_REAP_INTERVAL_MS=120000
# MAILFEED_USER_CONCURRENCY=3
# MAILFEED_LIVE_AI_THRESHOLD=15

