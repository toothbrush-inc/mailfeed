generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  emails        Email[]
  links         Link[]
  linkReports   LinkReport[]
  settings      Json      @default("{}")
  hiddenDomains String[]  @default([])
  // Envelope encryption: per-user DEK wrapped by the KEK (Cloud KMS or
  // MAILFEED_KEK). Minted on first use; deleting it crypto-shreds the
  // user's encrypted rows.
  dekWrapped    String?
  // The user's own LLM API keys (BYOK), encrypted under their DEK with a
  // prefix the transparent read path refuses to decrypt. See lib/user-keys.ts.
  apiKeysEnc    String?
  lastSyncAt          DateTime?
  syncQuery           String?    // Email query active when sync state was captured
  syncNewestEmailDate DateTime?  // receivedAt of most recent synced email
  syncOldestEmailDate DateTime?  // receivedAt of oldest synced email
  // Hourly worker: lock + last outcome (not the interactive lastSyncAt)
  scheduledSyncStartedAt DateTime?
  lastScheduledSyncAt    DateTime?
  lastScheduledSyncError String?  @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  geminiBatches GeminiBatch[]
  aiUsage       AiUsage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model Email {
  id          String    @id @default(cuid())
  userId      String
  gmailId     String
  threadId    String?
  subject     String?
  snippet     String?
  receivedAt  DateTime
  processedAt DateTime?
  rawContent  String?   @db.Text

  // AI-extracted tags from BAML IngestEmail
  tags        EmailTag[]
  ingestedAt  DateTime?

  // Vector embeddings for semantic search (managed via raw SQL)
  // embedding column is vector(768) type, not directly supported by Prisma
  embeddingStatus String?   @default("PENDING")  // PENDING, PROCESSING, COMPLETED, FAILED, SKIPPED
  embeddedAt      DateTime?
  embeddingError  String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@unique([userId, gmailId])
  @@index([userId])
  @@index([gmailId])
  @@index([receivedAt])
  @@index([embeddingStatus])
}

enum EmailTag {
  ARTICLE_LINK
  REMINDER
  MEETING_INFO
  TODO
  OTHER
}

model Link {
  id           String  @id @default(cuid())
  userId       String
  emailId      String?
  parentLinkId String?
  url          String
  urlHash      String
  domain       String?

  // Final URL after redirects (for deduplication and display)
  finalUrl      String?
  finalUrlHash  String?
  finalDomain   String?
  wasRedirected Boolean  @default(false)

  title    String?
  description String?
  imageUrl String?

  // Content analysis
  contentText    String? @db.Text
  contentHtml    String? @db.Text  // Clean article HTML from Readability (preserves structure)
  rawHtml        String? @db.Text  // Raw HTML for AI fallback parsing
  summary        String? @db.Text
  readingTimeMin Int?
  wordCount      Int?

  // AI-generated fields
  aiSummary       String?  @db.Text
  aiKeyPoints     String[]
  aiCategory      String?
  aiTags          String[]
  // BAML IngestLink tag types
  linkTags        String[]  // ARTICLE, VIDEO, IMAGE, AUDIO, etc.
  contentTags     String[]  // TECHNOLOGY, BUSINESS, SCIENCE, etc.
  metadataTags    String[]  // OPEN_ACCESS, LOGIN_REQUIRED, PAYMENT_REQUIRED, etc.
  worthinessScore Float?
  uniquenessScore Float?
  isHighlighted   Boolean  @default(false)
  highlightReason String?
  // Last AI analysis failure; cleared when analysis succeeds. Automatic
  // analysis stops after MAX_AUTO_ANALYSIS_ATTEMPTS (lib/analysis.ts).
  analysisError    String?  @db.Text
  analysisAttempts Int      @default(0)

  // Fetch status
  fetchStatus   FetchStatus @default(PENDING)
  fetchError    String?
  contentSource String?     // "direct", "wayback", etc. - indicates where content was fetched from
  archivedUrl   String?     // Wayback Machine URL if content was fetched from archive
  isPaywalled   Boolean     @default(false)
  paywallType   String?

  // Read status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Liked by the user (explicit action only; independent of read state)
  isLiked Boolean   @default(false)
  likedAt DateTime?

  // Embedding for RAG (vector column managed via raw SQL)
  embeddingStatus String?   @default("PENDING")  // PENDING, PROCESSING, COMPLETED, FAILED, SKIPPED
  embeddedAt      DateTime?
  embeddingError  String?

  // Social posts: what the embed endpoint says about the post beyond its
  // text (attached video, the post it quotes). See lib/post-context.ts.
  postContext Json?
  // Nested links: how the link was found. null = linked in the post itself,
  // QUOTED_POST = linked in the post it quotes, AI_LOOKUP = found by the
  // media lookup (lib/media-lookup.ts), with foundRole saying what it is:
  // FULL or CLIP (a video), EPISODE (a podcast episode), BOOK.
  foundVia  String?
  foundRole String?
  // Where a link that was moved to the feed came from, in words, e.g.
  // "From the show notes of Costco (Acquired)". The link no longer has a
  // parent to say so.
  originNote String? @db.Text
  // Books the AI analysis says this page recommends or discusses:
  // [{ title, author }]. The media lookup matches them in a book catalog.
  mentionedBooks Json?
  // Media lookup, for a post whose video links nowhere or that names a
  // recording or a book, and for a page with mentionedBooks: PENDING,
  // RUNNING, FOUND, NOT_FOUND, SKIPPED, FAILED or REJECTED (everything it
  // found was marked wrong). null = nothing to look up.
  lookupStatus String?
  lookupAt     DateTime?
  lookupNote   String?   @db.Text
  // Found links the user marked as wrong (their media keys), so a later
  // lookup doesn't bring them back
  lookupRejected String[] @default([])

  // Automatic retries of temporary fetch failures (worker)
  fetchRetryCount  Int       @default(0)
  lastFetchRetryAt DateTime?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fetchedAt  DateTime?
  analyzedAt DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         Email?        @relation(fields: [emailId], references: [id], onDelete: SetNull)
  parentLink    Link?         @relation("NestedLinks", fields: [parentLinkId], references: [id], onDelete: SetNull)
  childLinks    Link[]        @relation("NestedLinks")
  categories    LinkCategory[]
  reports       LinkReport[]
  fetchAttempts FetchAttempt[]

  @@unique([userId, urlHash])
  @@index([userId])
  @@index([emailId])
  @@index([parentLinkId])
  @@index([fetchStatus])
  @@index([aiCategory])
  @@index([isHighlighted])
  @@index([isRead])
  @@index([userId, isLiked])
  @@index([createdAt])
  @@index([worthinessScore])
  @@index([finalUrlHash])
  @@index([embeddingStatus])
  @@index([userId, lookupStatus])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String?
  icon        String?

  links LinkCategory[]

  @@index([slug])
}

model LinkCategory {
  linkId     String
  categoryId String
  confidence Float?

  link     Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([linkId, categoryId])
}

enum FetchStatus {
  PENDING
  FETCHING
  FETCHED
  ANALYZING
  COMPLETED
  FAILED
  PAYWALL_DETECTED
}

// Tracks each individual fetch attempt for debugging and visibility
model FetchAttempt {
  id          String   @id @default(cuid())
  linkId      String
  operationId String   // Groups attempts within one fallback chain run
  fetcherId   String   // "direct", "wayback"
  fetcherName String?  // "Direct Fetch", "Wayback Machine"
  trigger     String   // "sync", "refetch", "wayback_manual"
  sequence    Int      // 1-indexed position in fallback chain
  success     Boolean
  error       String?  @db.Text
  rawHtml     String?  @db.Text
  httpStatus  Int?
  durationMs  Int
  createdAt   DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, createdAt])
  @@index([operationId])
}

// User reports for links with fetch/parse issues
model LinkReport {
  id        String   @id @default(cuid())
  linkId    String
  userId    String
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([userId])
  @@index([createdAt])
}

// Per-user Gemini Batch API job. itemIds are Link or Email ids; apply always
// filters by this row's userId so another mailbox cannot be written.
model GeminiBatch {
  id          String   @id @default(cuid())
  userId      String
  geminiName  String   @unique
  kind        String   // ANALYZE_LINKS | EMBED_LINKS | EMBED_EMAILS
  status      String   // PENDING | RUNNING | SUCCEEDED | FAILED | EXPIRED | CANCELLED
  itemIds     String[]
  model       String?
  error       String?  @db.Text
  submittedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

// One row per billed AI call (or per item of a Gemini batch), with the
// token counts the provider reported and the cost at the list price in
// effect when it ran. Feeds "Your AI spend" in Settings.
model AiUsage {
  id             String   @id @default(cuid())
  userId         String
  kind           String   // ANALYZE_LINK | INGEST_EMAIL | CHAT
  model          String
  batch          Boolean  @default(false)
  inputTokens    Int
  outputTokens   Int      // includes thinking tokens, billed as output
  thinkingTokens Int      @default(0)
  // Google searches the call ran (search grounding), billed per search on
  // top of tokens. costUsd includes that fee.
  searchRequests Int      @default(0)
  costUsd        Float?   // null when the model has no known price
  linkId         String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
